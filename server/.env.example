# --- required ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/gym_platform
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# --- tenancy ---
# Gyms get <slug>.ROOT_DOMAIN automatically; custom domains are added per gym in the platform console.
ROOT_DOMAIN=gymplatform.app
# Fallback gym for hosts that match nothing (handy for localhost / a single *.vercel.app URL)
DEFAULT_TENANT_SLUG=demo
# Extra browser origins always allowed by CORS (comma separated). Gym domains are allowed automatically.
CLIENT_ORIGINS=http://localhost:5173
# --- optional services ---
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Auto-attach gym domains to the client Vercel project
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# --- seed only ---
PLATFORM_ADMIN_EMAIL=vendor@example.com
PLATFORM_ADMIN_PASSWORD=change-me-now
PORT=5000
